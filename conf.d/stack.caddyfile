*.jctower.itsjc.net {
	import cloudflare_tls

	@radarr host radarr.jctower.itsjc.net
	handle @radarr {
		import security_headers
		reverse_proxy radarr:7878
	}

	@sonarr host sonarr.jctower.itsjc.net
	handle @sonarr {
		import security_headers
		reverse_proxy sonarr:8989
	}
    
    # Continue adding your standard containers here...
}
