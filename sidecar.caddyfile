# --- Routing for qBittorrent ---
	@qbittorrent host qbittorrent.{env.DOMAIN_NAME}
	handle @qbittorrent {
		import security_headers
		reverse_proxy tailscaled:8008
	}

	# --- Routing for aMuTorrent ---
	@amutorrent host amutorrent.{env.DOMAIN_NAME}
	handle @amutorrent {
		import security_headers
		reverse_proxy tailscaled:4000
	}

	# --- Routing for Stash ---
